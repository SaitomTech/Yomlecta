{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "process:allow-restart",
    "shell:allow-kill",
    "shell:allow-open",
    "shell:allow-stdin-write",
    "updater:default",
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**/*"
        },
        {
          "path": "/Volumes"
        },
        {
          "path": "/Volumes/**/*"
        },
        {
          "path": "$APPLOCALDATA/projects"
        },
        {
          "path": "$APPLOCALDATA/projects/*"
        },
        {
          "path": "$APPLOCALDATA/projects/**/*"
        },
        {
          "path": "$APPLOCALDATA/projects/*/.trash"
        },
        {
          "path": "$APPLOCALDATA/projects/*/.trash/*"
        },
        {
          "path": "$APPLOCALDATA/projects/*/.trash/**/*"
        },
        {
          "path": "$APPLOCALDATA/project-trash"
        },
        {
          "path": "$APPLOCALDATA/project-trash/*"
        },
        {
          "path": "$APPLOCALDATA/project-trash/**/*"
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/ffprobe",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/whisper-cli",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/llama-server",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/apple-vision-ocr",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/apple-speech-transcriber",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/apple-foundation-models",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/apple-translator",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/yt-dlp",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/whisper-cli",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/llama-server",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/apple-vision-ocr",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/apple-speech-transcriber",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/apple-foundation-models",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/apple-translator",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/yt-dlp",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPLOCALDATA/projects" },
        { "path": "$APPLOCALDATA/projects/*" },
        { "path": "$APPLOCALDATA/projects/**/*" },
        { "path": "$APPLOCALDATA/projects/*/.trash" },
        { "path": "$APPLOCALDATA/projects/*/.trash/*" },
        { "path": "$APPLOCALDATA/projects/*/.trash/**/*" },
        { "path": "$APPLOCALDATA/project-trash" },
        { "path": "$APPLOCALDATA/project-trash/*" },
        { "path": "$APPLOCALDATA/project-trash/**/*" },
        { "path": "$APPLOCALDATA/models" },
        { "path": "$APPLOCALDATA/models/**/*" },
        { "path": "$HOME" },
        { "path": "$HOME/**/*" },
        { "path": "/Volumes" },
        { "path": "/Volumes/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$APPLOCALDATA/projects" },
        { "path": "$APPLOCALDATA/projects/*" },
        { "path": "$APPLOCALDATA/projects/**/*" },
        { "path": "$APPLOCALDATA/projects/*/.trash" },
        { "path": "$APPLOCALDATA/projects/*/.trash/*" },
        { "path": "$APPLOCALDATA/projects/*/.trash/**/*" },
        { "path": "$APPLOCALDATA/project-trash" },
        { "path": "$APPLOCALDATA/project-trash/*" },
        { "path": "$APPLOCALDATA/project-trash/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$APPLOCALDATA/projects" },
        { "path": "$APPLOCALDATA/projects/*" },
        { "path": "$APPLOCALDATA/projects/**/*" },
        { "path": "$APPLOCALDATA/projects/*/exports/.asset-manifest.json" },
        { "path": "$APPLOCALDATA/projects/*/articles/*/exports/.asset-manifest.json" },
        { "path": "$APPLOCALDATA/projects/*/.trash" },
        { "path": "$APPLOCALDATA/projects/*/.trash/*" },
        { "path": "$APPLOCALDATA/projects/*/.trash/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APPLOCALDATA/projects" },
        { "path": "$APPLOCALDATA/projects/*" },
        { "path": "$APPLOCALDATA/projects/**/*" },
        { "path": "$APPLOCALDATA/projects/*/exports/.asset-manifest.json" },
        { "path": "$APPLOCALDATA/projects/*/articles/*/exports/.asset-manifest.json" },
        { "path": "$APPLOCALDATA/projects/*/.trash" },
        { "path": "$APPLOCALDATA/projects/*/.trash/*" },
        { "path": "$APPLOCALDATA/projects/*/.trash/**/*" },
        { "path": "$APPLOCALDATA/project-trash" },
        { "path": "$APPLOCALDATA/project-trash/*" },
        { "path": "$APPLOCALDATA/project-trash/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$APPLOCALDATA/projects" },
        { "path": "$APPLOCALDATA/projects/*" },
        { "path": "$APPLOCALDATA/projects/**/*" },
        { "path": "$APPLOCALDATA/models/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        { "path": "$APPLOCALDATA/projects" },
        { "path": "$APPLOCALDATA/projects/*" },
        { "path": "$APPLOCALDATA/projects/**/*" },
        { "path": "$HOME" },
        { "path": "$HOME/**/*" },
        { "path": "/Volumes" },
        { "path": "/Volumes/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$APPLOCALDATA/models/**/*" },
        { "path": "$APPLOCALDATA/projects" },
        { "path": "$APPLOCALDATA/projects/*" },
        { "path": "$APPLOCALDATA/projects/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPLOCALDATA/models/**/*" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$APPLOCALDATA/models/**/*" },
        { "path": "$APPLOCALDATA/projects" },
        { "path": "$APPLOCALDATA/projects/*" },
        { "path": "$APPLOCALDATA/projects/**/*" },
        { "path": "$APPLOCALDATA/projects/*/.trash" },
        { "path": "$APPLOCALDATA/projects/*/.trash/*" },
        { "path": "$APPLOCALDATA/projects/*/.trash/**/*" },
        { "path": "$APPLOCALDATA/project-trash" },
        { "path": "$APPLOCALDATA/project-trash/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "$APPLOCALDATA/models/**/*" },
        { "path": "$APPLOCALDATA/projects" },
        { "path": "$APPLOCALDATA/projects/*" },
        { "path": "$APPLOCALDATA/projects/**/*" },
        { "path": "$APPLOCALDATA/projects/*/.trash" },
        { "path": "$APPLOCALDATA/projects/*/.trash/*" },
        { "path": "$APPLOCALDATA/projects/*/.trash/**/*" },
        { "path": "$APPLOCALDATA/project-trash" },
        { "path": "$APPLOCALDATA/project-trash/*" },
        { "path": "$APPLOCALDATA/project-trash/**/*" }
      ]
    }
  ]
}
